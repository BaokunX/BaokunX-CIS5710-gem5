diff --git a/src/cpu/pred/2bit_local.cc b/src/cpu/pred/2bit_local.cc
index 34b495bc21..f697002a64 100644
--- a/src/cpu/pred/2bit_local.cc
+++ b/src/cpu/pred/2bit_local.cc
@@ -57,6 +57,8 @@ LocalBP::LocalBP(const LocalBPParams &params)
       localCtrBits(params.localCtrBits),
       localPredictorSets(localPredictorSize / localCtrBits),
       localCtrs(localPredictorSets, SatCounter8(localCtrBits)),
+      tagMatching(params.tagMatching),
+      localTags(localPredictorSets, 0),
       indexMask(localPredictorSets - 1)
 {
     if (!isPowerOf2(localPredictorSize)) {
@@ -98,6 +100,10 @@ LocalBP::lookup(ThreadID tid, Addr branch_addr, void * &bp_history)
 {
     bool taken;
     unsigned local_predictor_idx = getLocalIndex(branch_addr);
+    if (tagMatching &&
+    localTags[local_predictor_idx] != branch_addr) {
+    return false;
+}
 
     DPRINTF(Fetch, "Looking up index %#x\n",
             local_predictor_idx);
@@ -127,6 +133,18 @@ LocalBP::update(ThreadID tid, Addr branch_addr, bool taken, void *&bp_history,
 
     // Update the local predictor.
     local_predictor_idx = getLocalIndex(branch_addr);
+    if (tagMatching &&
+    localTags[local_predictor_idx] != branch_addr) {
+
+    const unsigned threshold = 1U << (localCtrBits - 1);
+    const unsigned initialValue = taken ? threshold : threshold - 1;
+
+    localCtrs[local_predictor_idx] =
+        SatCounter8(localCtrBits, initialValue);
+
+    localTags[local_predictor_idx] = branch_addr;
+    return;
+}
 
     DPRINTF(Fetch, "Looking up index %#x\n", local_predictor_idx);
 
